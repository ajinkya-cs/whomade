{
  "name": "whomade",
  "version": "0.2.0",
  "description": "Who made this image? Verifies C2PA Content Credentials, reads AI-generator metadata and spots Gemini's watermark. Library, CLI and MCP server.",
  "keywords": [
    "ai-detection",
    "ai-generated",
    "c2pa",
    "content-credentials",
    "provenance",
    "iptc",
    "deepfake",
    "mcp",
    "mcp-server",
    "gemini",
    "synthid",
    "watermark"
  ],
  "license": "MIT",
  "author": "Ajinkya Muley (https://github.com/ajinkya-cs)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajinkya-cs/whomade.git"
  },
  "homepage": "https://github.com/ajinkya-cs/whomade#readme",
  "bugs": "https://github.com/ajinkya-cs/whomade/issues",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "whomade": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "node --test test/*.test.ts",
    "update-trust-list": "node scripts/update-trust-list.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@peculiar/x509": "^2.2.0",
    "@trustnxt/c2pa-ts": "^0.14.1",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "@types/pngjs": "^6.0.5",
    "typescript": "^7.0.2"
  },
  "mcpName": "io.github.ajinkya-cs/whomade"
}
